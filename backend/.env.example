# AULAIA - BACKEND
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Generar un secreto aleatorio de al menos 32 caracteres para cada entorno.
# En producción el backend rechazará el secreto de ejemplo.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRES_IN=7d

# Ruta relativa a backend/ salvo que configures una ruta absoluta.
DATABASE_PATH=./database/aulaia.sqlite

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Solo para crear el primer administrador mediante npm run admin:create.
# Usar un correo propio y una contraseña única de al menos 16 caracteres.
ADMIN_EMAIL=admin@cambiar-este-dominio.invalid
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CLAVE_UNICA_DE_AL_MENOS_16_CARACTERES
